                                                   "draft_reference":  "draft-04-01",
                                                   "record_type":  "Asset",
                                                   "title":  "Asset: Identity Access Management System for Driver Dispatch",
                                                   "content":  "The proposed regional delivery operator will handle customer addresses, driver dispatch, and supplier integrations. To ensure the integrity of the dispatch service and verify all systems and roles, a specific Identity Access Management (IAM) system will be established. This system will manage the access rights and identity verification for drivers and dispatchers. The IAM system will be crucial for maintaining the confidentiality and integrity of the dispatch service and customer data.",
                                                   "proposed_attributes":  [
                                                                               {
                                                                                   "field":  "asset_type",
                                                                                   "proposed_value":  "Information System"
                                                                               },
                                                                               {
                                                                                   "field":  "business_purpose",
                                                                                   "proposed_value":  "To manage and verify the identity and access rights of drivers and dispatchers, ensuring the integrity of the dispatch service and customer data."
                                                                               },
                                                                               {
                                                                                   "field":  "owner_role",
                                                                                   "proposed_value":  "Information Security Manager"
                                                                               },
                                                                               {
                                                                                   "field":  "information_classification",
                                                                                   "proposed_value":  "Confidential"
                                                                               }
                                                                           ],
                                                   "evidence_request":  "Establish a detailed IAM system design document, including access control policies, identity verification procedures, and a risk assessment report.",
                                                   "verification_question":  "Can the IAM system be designed and implemented to ensure that only authorized drivers and dispatchers have access to the dispatch service and customer data?",
