                                                   "draft_reference":  "draft-07-01",
                                                   "record_type":  "AppliedControl",
                                                   "title":  "Applied control: Verify dispatch service integrity through role-based access control",
                                                   "content":  "To ensure the integrity of the dispatch service and customer data, the Information Security Manager will be responsible for implementing role-based access control (RBAC) to verify the dispatch service integrity. This safeguard will be enforced by configuring RBAC settings and approving role assignments for different dispatch roles, including drivers, dispatchers, and customer service representatives. The test method will involve exporting the RBAC configuration settings and verifying that only authorized personnel have access to the dispatch service.",
                                                   "proposed_attributes":  [
                                                                               {
                                                                                   "field":  "linked_risk_reference",
                                                                                   "proposed_value":  "draft-06-01"
                                                                               },
                                                                               {
                                                                                   "field":  "control_objective",
                                                                                   "proposed_value":  "Ensure the integrity of the dispatch service and customer data by verifying operator identity and access rights."
                                                                               },
                                                                               {
                                                                                   "field":  "implementation_steps",
                                                                                   "proposed_value":  "1. Define and assign roles for drivers, dispatchers, and customer service representatives. 2. Configure RBAC settings to enforce role-based access control. 3. Approve role assignments and monitor access logs for unauthorized access attempts."
                                                                               },
                                                                               {
                                                                                   "field":  "test_method",
                                                                                   "proposed_value":  "Export the RBAC configuration settings and verify that only authorized personnel have access to the dispatch service by reviewing access logs and RBAC configuration files."
                                                                               }
                                                                           ],
                                                   "evidence_request":  "Exported RBAC configuration settings and access logs for review.",
